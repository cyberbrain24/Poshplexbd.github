# ============================================================
# Poshplex Environment Configuration
# Copy this to .env and fill in your values.
# ============================================================

# Django Core
SECRET_KEY=your_secure_secret_key_here
DEBUG=True
ALLOWED_HOSTS=*

# Database (PostgreSQL — matches docker-compose)
DATABASE_URL=postgres://poshplex_user:your_secure_db_password@localhost:5432/poshplex

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery Worker
CELERY_BROKER_URL=redis://localhost:6379/1

# Media
MEDIA_URL=http://localhost:8000/media/

# --- AI / External Services (optional for local dev) ---
OPENAI_API_KEY=
META_GRAPH_API_TOKEN=
TIKTOK_API_KEY=
STEADFAST_API_KEY=
STEADFAST_API_SECRET=
