# ============================================================
# Poshplex Production Environment Variables
# Copy this file to `.env` on your VPS and update the values
# ============================================================

# ── DOMAIN & URLS ───────────────────────────────────────────
# The main public domain for your storefront and API
PUBLIC_DOMAIN=https://yourdomain.com
PUBLIC_API_URL=https://yourdomain.com/api/v1

# Django Security
DEBUG=False
SECRET_KEY="replace-this-with-a-very-long-secure-random-string"
ALLOWED_HOSTS="yourdomain.com,www.yourdomain.com,localhost,127.0.0.1"
CORS_ALLOWED_ORIGINS="https://yourdomain.com"

# ── DATABASE ────────────────────────────────────────────────
# PostgreSQL Configuration
POSTGRES_USER=poshplex_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=poshplex
DATABASE_URL=postgres://poshplex_user:your_secure_db_password@postgres:5432/poshplex

# ── REDIS & CELERY ──────────────────────────────────────────
# Used for Caching and Background tasks (Docker internal network)
REDIS_URL=redis://redis:6379/1

# ── JWT AUTH ────────────────────────────────────────────────
# Optional Overrides for token expiration
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

# ── OTHER SETTINGS ──────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
